{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://2463-fde.github.io/content/expectations.v1.schema.json",
  "title": "FDE expectation manifest v1",
  "description": "The shared learner and trainer expectation-manifest contract, including explicit authored stakeholder positions and cross-cutting conflicts. The public generator emits learner-visible items only; trainer-visible items are stored server-side.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reviewed_by_role",
    "items"
  ],
  "properties": {
    "schema": { "const": "fde.expectations/v1" },
    "reviewed_by_role": { "const": "trainer" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "relativeDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["week", "day"],
      "properties": {
        "week": { "type": "integer", "minimum": 1, "maximum": 99 },
        "day": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
      }
    },
    "weekRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "integer", "minimum": 1, "maximum": 99 },
        "to": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "project",
        "week",
        "field",
        "text",
        "visibility",
        "owner_role",
        "effective_from",
        "effective_to",
        "supersedes",
        "version",
        "source",
        "stakeholder_context"
      ],
      "properties": {
        "id": {
          "type": "string",
          "anyOf": [
            { "pattern": "^[a-z][a-z0-9-]*\\.w[0-9]{2}\\.[a-z][a-z0-9-]*(?:\\.[a-z0-9][a-z0-9-]*)?$" },
            { "pattern": "^track\\.[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
            { "pattern": "^schedule\\.w[0-9]{2}\\.(?:mon|tue|wed|thu|fri|sat|sun)$" },
            { "pattern": "^alt\\.[a-z][a-z0-9-]*\\.trainer$" }
          ]
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "week": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 99 },
            { "const": "*" },
            { "$ref": "#/$defs/weekRange" }
          ]
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^<>]*$"
        },
        "visibility": {
          "enum": ["learner", "trainer"]
        },
        "owner_role": {
          "enum": ["client", "client_business", "client_technical_lead", "domain_expert", "trainer", "security", "learner"]
        },
        "effective_from": {
          "oneOf": [
            { "$ref": "#/$defs/relativeDate" },
            { "type": "null" }
          ]
        },
        "effective_to": {
          "oneOf": [
            { "$ref": "#/$defs/relativeDate" },
            { "type": "null" }
          ]
        },
        "supersedes": {
          "description": "The record this item replaces. Every change to a position's classification state — non_negotiable to preference, preference to non_negotiable, retiring a classified position, or re-classifying a retired one — requires both a version increment and this field set to '<position_key>@v<superseded version>'. First-time classification of previously unclassified content is an ordinary versioned addition and needs no supersession record. The append-only history lives in tools/expectations/classification-baseline.json and is checked against this manifest on every build.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "description": "Source file, path within that file, and the SHA-256 of the exact file content the text was generated from. The content hash is the durable pin: it survives every merge style, and it goes stale the moment the source wording changes.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_./-]+#[^@]+@sha256:[0-9a-f]{64}$"
        },
        "stakeholder_context": {
          "oneOf": [
            { "$ref": "#/$defs/stakeholderContext" },
            { "type": "null" }
          ]
        }
      }
    },
    "stakeholderRole": {
      "enum": ["client_business", "client_technical_lead"]
    },
    "approvalRole": {
      "enum": ["client_business", "client_technical_lead", "domain_expert", "trainer", "security"]
    },
    "conflictDimension": {
      "enum": ["delivery", "scope", "cost", "risk", "reliability", "security", "maintainability", "stakeholder_confidence"]
    },
    "stakeholderContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_key",
        "stakeholder_role",
        "position_type",
        "approval_authority",
        "rationale",
        "pressure",
        "success_criteria",
        "boundaries",
        "trade_space",
        "escalation_triggers",
        "conflicts"
      ],
      "properties": {
        "position_key": {
          "description": "Human-assigned durable identity for this stakeholder position, written by the author who classifies it. Format: <project>.w<NN>.<business|techlead>.<topic-slug>, e.g. 'healthcare.w07.business.guardrail-proof'. Authored in tools/expectations/overrides.json under stakeholder_position_keys, keyed by the carrying item id, and folded into this field by the generator. It is chosen once and never changes when the authored wording changes, so classification history, versions, and supersession stay bound to the position rather than to the sentence. Never derive it from item text; the item id already carries the display slug.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*\\.w[0-9]{2}\\.(?:business|techlead)\\.[a-z0-9][a-z0-9-]*$"
        },
        "stakeholder_role": { "$ref": "#/$defs/stakeholderRole" },
        "position_type": {
          "enum": ["non_negotiable", "preference"]
        },
        "approval_authority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/approvalRole" }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "pressure": { "type": "string", "minLength": 1 },
        "success_criteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "boundaries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "trade_space": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "escalation_triggers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/stakeholderConflict" }
        }
      }
    },
    "stakeholderConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["with_id", "dimensions", "rationale", "escalation_trigger"],
      "properties": {
        "with_id": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/conflictDimension" }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "escalation_trigger": { "type": "string", "minLength": 1 }
      }
    }
  }
}
